# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Administrator ────────────────────────────────────────────────────────────
# The only admin account. Nobody becomes an admin by signing up: this account
# is created on startup from these values and repaired from them on every
# restart, so editing this file is the way back in if the password is lost.
SAIRA_ADMIN_EMAIL=admin@example.com
SAIRA_ADMIN_NAME=Admin
SAIRA_ADMIN_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# Activation codes and password resets. Any SMTP server works. With SAIRA_SMTP_HOST
# unset, codes are written to the server log instead of sent — development only.
SAIRA_SMTP_HOST=
SAIRA_SMTP_PORT=587          # 587 STARTTLS, 465 implicit TLS
SAIRA_SMTP_USER=
SAIRA_SMTP_PASSWORD=         # an app password, never an account password
SAIRA_MAIL_FROM=Saira <no-reply@example.com>
SAIRA_APP_URL=http://localhost:3001

# ── Secrets ──────────────────────────────────────────────────────────────────
# Both default to the generated .master.key. Set them in production, and keep a
# backup: the master key derives every user's encryption key, so losing it makes
# all stored conversations permanently unreadable.
# SAIRA_MASTER_KEY=
# SAIRA_JWT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite beside the code. Point at PostgreSQL in production.
# SAIRA_DB_URL=postgresql+psycopg://user:pass@localhost/saira
