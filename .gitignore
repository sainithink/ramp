.env
.profile.key
profile.enc
.memory.key
memory.enc
.prefs.key
preferences.enc
google_token.json
*.log
*.onnx
*.bin
conversation_log.md
data/
.claude/
instagram_briefs/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/
.DS_Store

# Multi-tenant: master key derives every user's encryption key.
# Losing it makes all stored conversations unreadable; leaking it exposes them.
.master.key
saira.db
saira.db-wal
saira.db-shm

# Frontend: web/ holds the React source, static/build holds its compiled output.
# The build is committed so deploying needs no Node toolchain on the server —
# the blanket build/ rule above would otherwise swallow it.
!static/build/
web/node_modules/
web/.vite/
web/*.tsbuildinfo
